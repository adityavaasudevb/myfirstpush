// v3.4 ADDITIONS to src/Services/Insurance/InsuranceService.API/appsettings.json
//
// Paste these two blocks INSIDE the existing root object (sibling keys of "Insurance"),
// remembering that JSON does not allow trailing commas. The comments below are here for
// you to read — remove them before pasting, JSON has no comment syntax.

"DocumentStorage": {
  // Relative paths are resolved against the API's content root (bin/Debug/net8.0/...).
  // Absolute paths work too; keep it off a network share for the demo.
  "RootPath": "App_Data/uploads"
},

"Ai": {
  // "inprocess"  — no network. Deterministic checks only; the UI shows "AI · offline".
  // "vertex"     — live Gemini call through Vertex AI using the machine's ADC
  //                (`gcloud auth application-default login`). Costs ~Rs 0.04 per document.
  // "fake"       — test double, returns a canned extraction; never used in the demo.
  "Provider": "inprocess",

  // Vertex settings (only read when Provider = "vertex")
  "ProjectId": "CHANGE-ME-your-gcp-project",
  "Location": "asia-south1",
  "Model": "gemini-3.5-flash-lite",
  "TimeoutSeconds": 20,

  // Audit gate: documents on claims at or above this amount are auditable.
  // Below it, the surveyor sees the documents but no "AI check" button.
  "AuditThresholdInr": 10000,

  // Hard ceiling so a runaway loop can never repeat the Rs 3,785 CLI bill.
  "MaxCallsPerClaim": 3,
  "MaxCallsPerDay": 50
}
